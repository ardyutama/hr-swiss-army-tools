{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"

  // Email sending (Send to all). The app sends through one SMTP account per
  // installation; whoever installed the app fills in the section below and restarts
  // it. Until then Send to all refuses with an actionable message and the
  // Prepared messages flow keeps working as the no-SMTP path.
  //
  // Gmail:   Host "smtp.gmail.com", Port 587, Username = the full Gmail address,
  //          Password = an app password (https://myaccount.google.com/apppasswords),
  //          FromAddress = the same Gmail address.
  // Outlook: prefer the settings page's Microsoft Account sign-in. Basic auth here
  //          only fits M365 work/school accounts with SMTP AUTH enabled — Microsoft
  //          is retiring it.
  // Custom:  the provider's host and submission port (587 for STARTTLS, 465 for TLS).
  //
  // MicrosoftClientId: the project-owned public client for the settings page's
  //          Microsoft Account sign-in. A public-client ID is not a secret; leave
  //          empty to disable the Microsoft choice.
  //
  // "Smtp": {
  //   "Host": "smtp.gmail.com",
  //   "Port": 587,
  //   "Username": "",
  //   "Password": "",
  //   "FromAddress": "",
  //   "FromName": "",
  //   "MicrosoftClientId": ""
  // }
}
